# ==============================================================================
# SmartGarden Web (React + Vite) — Plantilla de Variables de Entorno
# ==============================================================================
# IMPORTANTE (Seguridad):
# - Toda variable con prefijo VITE_ es pública y se incrusta en el bundle del navegador.
# - NUNCA definas DATABASE_URL, SECRET_KEY, contraseñas ni claves privadas en VITE_*.
#
# Configura esta variable por separado en Vercel (Project Settings > Environment Variables)
# para cada entorno:
#   - Development : URL de tu API local (en tu archivo .env local, ignorado por Git)
#   - Preview     : URL del backend de staging/pruebas para ramas y Pull Requests
#   - Production  : URL pública HTTPS del backend Django en producción
# ==============================================================================

VITE_API_URL=https://tu-backend-produccion.ejemplo.com

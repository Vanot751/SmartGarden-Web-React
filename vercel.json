{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://smart-garden-api-django.vercel.app/admin/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://smart-garden-api-django.vercel.app/admin/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
